package com.comparator;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.stream.Collectors;

public class PipeFileComparator {

    /*
     * ============================================================
     * CONFIGURATION
     * ============================================================
     */

    private static final String DELIMITER_REGEX = "\\|";

    /*
     * CHANGE THIS LINE if you want a different matching key.
     *
     * Examples:
     *
     * Account only:
     * List.of(List.of("Account"));
     *
     * Account + RefNum:
     * List.of(List.of("Account", "RefNum"));
     *
     * Account + RefNum + EffectiveDate:
     * List.of(List.of("Account", "RefNum", "EffectiveDate"));
     */
    private static final List<List<String>> MATCH_PROFILES =
            List.of(List.of("Account"));

    /*
     * We consider two unmatched records to represent the same
     * logical record if their configured key matches and no more
     * than this many columns differ.
     */
    private static final int MAX_DIFFERENT_COLUMNS = 2;

    /*
     * Safety limit for column-level comparison.
     */
    private static final int MAX_FUZZY_RECORDS = 500_000;

    /*
     * Maximum number of examples written into report sections.
     */
    private static final int MAX_REPORT_EXAMPLES = 10_000;

    /*
     * Number of records sorted in memory at a time.
     */
    private static final int SORT_CHUNK_SIZE = 250_000;


    /*
     * ============================================================
     * FILE COLUMN DEFINITIONS
     * ============================================================
     */

    private static final List<String> COLUMNS = List.of(
            "MMO",                 // 1
            "Priority",            // 2
            "State",               // 3
            "ClerkID",             // 4
            "CountryCode",         // 5
            "Currency",            // 6
            "EqCurrency",          // 7
            "Reason",              // 8
            "PageNumber",          // 9
            "Statement",           // 10
            "Branch",              // 11
            "PayeeNum",            // 12
            "TaxID",               // 13
            "Location",            // 14
            "RefNum",              // 15
            "RepSerialNum",        // 16
            "SerialNumber",        // 17
            "DCIP",                // 18
            "Zip",                 // 19
            "CustAcctNum",         // 20
            "ImageCode",           // 21
            "CPCS",                // 22
            "UserText1",           // 23
            "UserText2",           // 24
            "Addr1",               // 25
            "Addr2",               // 26
            "City",                // 27
            "Name1",               // 28
            "Name2",               // 29
            "Account",             // 30
            "Company",             // 31
            "Class",               // 32
            "Department",          // 33
            "Amount",              // 34
            "EqAmount",            // 35
            "UserAmount1",         // 36
            "AmountRecov",         // 37
            "AvgRate",             // 38
            "Aged",                // 39
            "DaysRecovered",       // 40
            "UserNum1",            // 41
            "UserNum2",            // 42
            "AvailOrPaid",         // 43
            "EffectiveDate",       // 44
            "PostedOrIssue",       // 45
            "EqDate"               // 46
    );

    private static final int EXPECTED_COLUMN_COUNT =
            COLUMNS.size();


    private static final Map<String, Integer> COLUMN_INDEX =
            createColumnIndex();


    private static Map<String, Integer> createColumnIndex() {

        Map<String, Integer> result =
                new HashMap<>();

        for (int i = 0; i < COLUMNS.size(); i++) {
            result.put(COLUMNS.get(i), i);
        }

        return Collections.unmodifiableMap(result);
    }


    /*
     * ============================================================
     * VERY IMPORTANT:
     *
     * PARSE ONE PIPE-DELIMITED RECORD
     * ============================================================
     *
     * Your files have NO opening delimiter but DO have a closing
     * delimiter after the final column.
     *
     * Example:
     *
     * A|B|C|
     *
     * Logically this means 3 columns.
     *
     * But:
     *
     * line.split("\\|", -1)
     *
     * would produce:
     *
     * A
     * B
     * C
     * ""
     *
     * i.e. 4 values.
     *
     * Therefore we remove EXACTLY ONE trailing pipe before parsing.
     *
     * We do NOT modify the original raw record itself.
     * ============================================================
     */

    private static String[] parseColumns(
            String line
    ) {

        String lineForParsing = line;

        /*
         * Remove exactly one record-ending delimiter.
         */
        if (lineForParsing.endsWith("|")) {

            lineForParsing =
                    lineForParsing.substring(
                            0,
                            lineForParsing.length() - 1
                    );
        }

        return lineForParsing.split(
                DELIMITER_REGEX,
                -1
        );
    }


    /*
     * ============================================================
     * MAIN COMPARISON METHOD
     * ============================================================
     */

    public static ComparisonResult compare(
            Path productionFile,
            Path migratedFile,
            Path workingDirectory,
            Path reportFile
    ) throws IOException {

        Files.createDirectories(
                workingDirectory
        );


        /*
         * ========================================================
         * STEP 1
         *
         * Separate structurally valid and malformed records.
         * ========================================================
         */

        Path validProductionFile =
                workingDirectory.resolve(
                        "valid_production.txt"
                );


        Path validMigratedFile =
                workingDirectory.resolve(
                        "valid_migrated.txt"
                );


        ValidationResult productionValidation =
                validateAndSeparate(
                        productionFile,
                        validProductionFile,
                        "PRODUCTION"
                );


        ValidationResult migratedValidation =
                validateAndSeparate(
                        migratedFile,
                        validMigratedFile,
                        "MIGRATED"
                );


        /*
         * ========================================================
         * STEP 2
         *
         * Sort valid records externally.
         *
         * This makes comparison order-independent while still
         * preserving duplicates.
         * ========================================================
         */

        Path productionSorted =
                externalSort(
                        validProductionFile,
                        workingDirectory,
                        "production"
                );


        Path migratedSorted =
                externalSort(
                        validMigratedFile,
                        workingDirectory,
                        "migrated"
                );


        Path unmatchedProduction =
                workingDirectory.resolve(
                        "unmatched_production.txt"
                );


        Path unmatchedMigrated =
                workingDirectory.resolve(
                        "unmatched_migrated.txt"
                );


        /*
         * ========================================================
         * STEP 3
         *
         * Exact order-independent comparison.
         * ========================================================
         */

        ExactComparisonResult exactResult =
                exactCompare(
                        productionSorted,
                        migratedSorted,
                        unmatchedProduction,
                        unmatchedMigrated
                );


        /*
         * ========================================================
         * STEP 4
         *
         * Try matching unmatched records by Account (or whatever
         * MATCH_PROFILES is configured to use).
         * ========================================================
         */

        FuzzyComparisonResult fuzzyResult =
                fuzzyCompare(
                        unmatchedProduction,
                        unmatchedMigrated
                );


        /*
         * ========================================================
         * STEP 5
         *
         * Build final result.
         * ========================================================
         */

        ComparisonResult result =
                new ComparisonResult(

                        productionValidation.totalRecords(),
                        productionValidation.validRecords(),
                        productionValidation.invalidRecords(),

                        migratedValidation.totalRecords(),
                        migratedValidation.validRecords(),
                        migratedValidation.invalidRecords(),

                        exactResult.exactMatches(),

                        fuzzyResult.probableMatches().size(),

                        fuzzyResult.remainingProduction().size(),
                        fuzzyResult.remainingMigrated().size(),

                        fuzzyResult.probableMatches(),

                        fuzzyResult.remainingProduction(),
                        fuzzyResult.remainingMigrated(),

                        productionValidation.malformedRecords(),
                        migratedValidation.malformedRecords()
                );


        /*
         * ========================================================
         * STEP 6
         *
         * Write detailed report.
         * ========================================================
         */

        writeReport(
                result,
                reportFile
        );


        /*
         * Remove large temporary sorted files.
         */
        Files.deleteIfExists(
                productionSorted
        );

        Files.deleteIfExists(
                migratedSorted
        );


        return result;
    }


    /*
     * ============================================================
     * VALIDATE FILE STRUCTURE
     * ============================================================
     */

    private static ValidationResult validateAndSeparate(
            Path sourceFile,
            Path validOutputFile,
            String sourceName
    ) throws IOException {

        long totalRecords = 0;
        long validRecords = 0;
        long invalidRecords = 0;


        List<MalformedRecord> malformedRecords =
                new ArrayList<>();


        try (
                BufferedReader reader =
                        Files.newBufferedReader(
                                sourceFile,
                                StandardCharsets.UTF_8
                        );

                BufferedWriter validWriter =
                        Files.newBufferedWriter(
                                validOutputFile,
                                StandardCharsets.UTF_8
                        )
        ) {

            String line;

            long lineNumber = 0;


            while ((line = reader.readLine()) != null) {

                lineNumber++;
                totalRecords++;


                /*
                 * IMPORTANT:
                 * Uses parseColumns(), which understands your
                 * trailing record delimiter.
                 */
                String[] values =
                        parseColumns(line);


                if (values.length
                        == EXPECTED_COLUMN_COUNT) {

                    /*
                     * Keep ORIGINAL line.
                     *
                     * Do not remove trailing pipe from actual data.
                     */
                    validWriter.write(line);
                    validWriter.newLine();

                    validRecords++;

                } else {

                    invalidRecords++;


                    /*
                     * Save malformed record details, but DO NOT
                     * terminate processing.
                     */
                    if (malformedRecords.size()
                            < MAX_REPORT_EXAMPLES) {

                        malformedRecords.add(
                                new MalformedRecord(
                                        sourceName,
                                        lineNumber,
                                        EXPECTED_COLUMN_COUNT,
                                        values.length,
                                        line
                                )
                        );
                    }
                }
            }
        }


        return new ValidationResult(
                totalRecords,
                validRecords,
                invalidRecords,
                malformedRecords
        );
    }


    /*
     * ============================================================
     * EXACT ORDER-INDEPENDENT COMPARISON
     * ============================================================
     */

    private static ExactComparisonResult exactCompare(
            Path productionSorted,
            Path migratedSorted,
            Path unmatchedProduction,
            Path unmatchedMigrated
    ) throws IOException {

        long exactMatches = 0;


        try (
                BufferedReader productionReader =
                        Files.newBufferedReader(
                                productionSorted,
                                StandardCharsets.UTF_8
                        );

                BufferedReader migratedReader =
                        Files.newBufferedReader(
                                migratedSorted,
                                StandardCharsets.UTF_8
                        );

                BufferedWriter unmatchedProductionWriter =
                        Files.newBufferedWriter(
                                unmatchedProduction,
                                StandardCharsets.UTF_8
                        );

                BufferedWriter unmatchedMigratedWriter =
                        Files.newBufferedWriter(
                                unmatchedMigrated,
                                StandardCharsets.UTF_8
                        )
        ) {

            String production =
                    productionReader.readLine();


            String migrated =
                    migratedReader.readLine();


            while (production != null
                    || migrated != null) {


                /*
                 * Production exhausted.
                 */
                if (production == null) {

                    unmatchedMigratedWriter.write(
                            migrated
                    );

                    unmatchedMigratedWriter.newLine();


                    migrated =
                            migratedReader.readLine();

                    continue;
                }


                /*
                 * Migrated exhausted.
                 */
                if (migrated == null) {

                    unmatchedProductionWriter.write(
                            production
                    );

                    unmatchedProductionWriter.newLine();


                    production =
                            productionReader.readLine();

                    continue;
                }


                int comparison =
                        production.compareTo(
                                migrated
                        );


                /*
                 * Exact match.
                 */
                if (comparison == 0) {

                    exactMatches++;


                    production =
                            productionReader.readLine();


                    migrated =
                            migratedReader.readLine();

                }

                /*
                 * Production record not currently matched.
                 */
                else if (comparison < 0) {

                    unmatchedProductionWriter.write(
                            production
                    );

                    unmatchedProductionWriter.newLine();


                    production =
                            productionReader.readLine();

                }

                /*
                 * Migrated record not currently matched.
                 */
                else {

                    unmatchedMigratedWriter.write(
                            migrated
                    );

                    unmatchedMigratedWriter.newLine();


                    migrated =
                            migratedReader.readLine();
                }
            }
        }


        return new ExactComparisonResult(
                exactMatches
        );
    }


    /*
     * ============================================================
     * COLUMN-LEVEL / LOGICAL RECORD COMPARISON
     * ============================================================
     */

    private static FuzzyComparisonResult fuzzyCompare(
            Path unmatchedProductionFile,
            Path unmatchedMigratedFile
    ) throws IOException {


        List<DataRecord> productionRecords =
                readValidRecords(
                        unmatchedProductionFile
                );


        List<DataRecord> migratedRecords =
                readValidRecords(
                        unmatchedMigratedFile
                );


        /*
         * Safety check.
         */
        if (productionRecords.size()
                > MAX_FUZZY_RECORDS
                ||
                migratedRecords.size()
                        > MAX_FUZZY_RECORDS) {

            throw new IllegalStateException(
                    """
                    Too many unmatched valid records for column-level matching.

                    Production unmatched: %d
                    Migrated unmatched:   %d

                    This probably indicates a major difference between the
                    files rather than isolated field differences.

                    Increase MAX_FUZZY_RECORDS only if this is expected.
                    """
                            .formatted(
                                    productionRecords.size(),
                                    migratedRecords.size()
                            )
            );
        }


        /*
         * Build migrated record indexes by configured matching
         * profile(s).
         */
        List<Map<String, List<DataRecord>>> migratedIndexes =
                new ArrayList<>();


        for (List<String> profile
                : MATCH_PROFILES) {

            migratedIndexes.add(
                    buildIndex(
                            migratedRecords,
                            profile
                    )
            );
        }


        /*
         * Prevent one migrated record being assigned to
         * multiple production records.
         */
        Set<Long> usedMigratedRecordIds =
                new HashSet<>();


        List<RecordDifference> probableMatches =
                new ArrayList<>();


        List<DataRecord> remainingProduction =
                new ArrayList<>();


        /*
         * ========================================================
         * Try finding a migrated candidate for each production
         * mismatch.
         * ========================================================
         */

        for (DataRecord productionRecord
                : productionRecords) {


            Set<DataRecord> candidates =
                    new LinkedHashSet<>();


            /*
             * Search each configured matching profile.
             */
            for (int profileIndex = 0;
                 profileIndex < MATCH_PROFILES.size();
                 profileIndex++) {


                List<String> profile =
                        MATCH_PROFILES.get(
                                profileIndex
                        );


                String key =
                        buildKey(
                                productionRecord,
                                profile
                        );


                /*
                 * Cannot safely match empty keys.
                 */
                if (key.isBlank()) {
                    continue;
                }


                List<DataRecord> matchingCandidates =
                        migratedIndexes
                                .get(profileIndex)
                                .getOrDefault(
                                        key,
                                        Collections.emptyList()
                                );


                for (DataRecord candidate
                        : matchingCandidates) {


                    if (!usedMigratedRecordIds
                            .contains(
                                    candidate.id()
                            )) {

                        candidates.add(
                                candidate
                        );
                    }
                }
            }


            DataRecord bestCandidate =
                    null;


            List<ColumnDifference> bestDifferences =
                    null;


            /*
             * Compare all possible candidate records.
             */
            for (DataRecord candidate
                    : candidates) {


                List<ColumnDifference> differences =
                        findDifferences(
                                productionRecord,
                                candidate
                        );


                /*
                 * Only accept records differing by at most
                 * MAX_DIFFERENT_COLUMNS.
                 */
                if (differences.size()
                        <= MAX_DIFFERENT_COLUMNS) {


                    if (bestCandidate == null
                            ||
                            differences.size()
                                    < bestDifferences.size()) {


                        bestCandidate =
                                candidate;


                        bestDifferences =
                                differences;
                    }
                }
            }


            /*
             * Corresponding logical record found.
             */
            if (bestCandidate != null) {


                usedMigratedRecordIds.add(
                        bestCandidate.id()
                );


                probableMatches.add(
                        new RecordDifference(
                                productionRecord,
                                bestCandidate,
                                bestDifferences
                        )
                );

            } else {

                /*
                 * Nothing matching this production record.
                 */
                remainingProduction.add(
                        productionRecord
                );
            }
        }


        /*
         * Migrated records that were never consumed are extra.
         */
        List<DataRecord> remainingMigrated =
                migratedRecords
                        .stream()
                        .filter(
                                record ->
                                        !usedMigratedRecordIds
                                                .contains(
                                                        record.id()
                                                )
                        )
                        .toList();


        return new FuzzyComparisonResult(
                probableMatches,
                remainingProduction,
                remainingMigrated
        );
    }


    /*
     * ============================================================
     * FIND DIFFERING COLUMNS
     * ============================================================
     */

    private static List<ColumnDifference> findDifferences(
            DataRecord production,
            DataRecord migrated
    ) {

        List<ColumnDifference> differences =
                new ArrayList<>();


        for (int i = 0;
             i < EXPECTED_COLUMN_COUNT;
             i++) {


            String productionValue =
                    production.values()[i];


            String migratedValue =
                    migrated.values()[i];


            if (!Objects.equals(
                    productionValue,
                    migratedValue
            )) {


                differences.add(
                        new ColumnDifference(
                                i + 1,
                                COLUMNS.get(i),
                                productionValue,
                                migratedValue
                        )
                );


                /*
                 * Optimization:
                 *
                 * Once we've exceeded the permitted difference
                 * threshold, there is no need to compare the
                 * remaining columns for candidate selection.
                 */
                if (differences.size()
                        > MAX_DIFFERENT_COLUMNS) {

                    break;
                }
            }
        }


        return differences;
    }


    /*
     * ============================================================
     * BUILD INDEX BY CONFIGURABLE KEY
     * ============================================================
     */

    private static Map<String, List<DataRecord>> buildIndex(
            List<DataRecord> records,
            List<String> keyColumns
    ) {

        Map<String, List<DataRecord>> index =
                new HashMap<>();


        for (DataRecord record : records) {


            String key =
                    buildKey(
                            record,
                            keyColumns
                    );


            if (key.isBlank()) {
                continue;
            }


            index.computeIfAbsent(
                    key,
                    ignored ->
                            new ArrayList<>()
            ).add(
                    record
            );
        }


        return index;
    }


    /*
     * ============================================================
     * BUILD MATCHING KEY
     * ============================================================
     */

    private static String buildKey(
            DataRecord record,
            List<String> keyColumns
    ) {

        StringBuilder result =
                new StringBuilder();


        boolean hasAtLeastOneValue =
                false;


        for (String columnName
                : keyColumns) {


            Integer index =
                    COLUMN_INDEX.get(
                            columnName
                    );


            if (index == null) {

                throw new IllegalArgumentException(
                        "Unknown matching key column: "
                                + columnName
                );
            }


            String value =
                    record.values()[index];


            if (value != null
                    && !value.isBlank()) {

                hasAtLeastOneValue =
                        true;
            }


            result.append(
                    normalizeKeyValue(
                            value
                    )
            );


            /*
             * Internal separator.
             */
            result.append('\u0001');
        }


        if (!hasAtLeastOneValue) {
            return "";
        }


        return result.toString();
    }


    private static String normalizeKeyValue(
            String value
    ) {

        if (value == null) {
            return "";
        }

        return value.trim();
    }


    /*
     * ============================================================
     * READ UNMATCHED VALID RECORDS
     * ============================================================
     */

    private static List<DataRecord> readValidRecords(
            Path file
    ) throws IOException {


        List<DataRecord> records =
                new ArrayList<>();


        try (
                BufferedReader reader =
                        Files.newBufferedReader(
                                file,
                                StandardCharsets.UTF_8
                        )
        ) {


            String line;

            long recordId = 0;


            while ((line = reader.readLine()) != null) {


                recordId++;


                /*
                 * IMPORTANT:
                 * Uses parseColumns() so trailing pipe does NOT
                 * become an extra fake column.
                 */
                String[] values =
                        parseColumns(line);


                /*
                 * Should normally never occur because malformed
                 * rows were already removed earlier.
                 *
                 * But still continue safely instead of crashing.
                 */
                if (values.length
                        != EXPECTED_COLUMN_COUNT) {

                    continue;
                }


                records.add(
                        new DataRecord(
                                recordId,
                                line,
                                values
                        )
                );
            }
        }


        return records;
    }


    /*
     * ============================================================
     * REPORT GENERATION
     * ============================================================
     */

    private static void writeReport(
            ComparisonResult result,
            Path reportFile
    ) throws IOException {


        try (
                BufferedWriter writer =
                        Files.newBufferedWriter(
                                reportFile,
                                StandardCharsets.UTF_8
                        )
        ) {


            /*
             * ====================================================
             * OVERALL SUMMARY
             * ====================================================
             */

            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "FILE COMPARISON REPORT"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            writer.newLine();


            writeLine(
                    writer,
                    "PRODUCTION"
            );


            writeLine(
                    writer,
                    "------------------------------------------------------------"
            );


            writeLine(
                    writer,
                    "Total records       : "
                            + result.productionTotalRecords()
            );


            writeLine(
                    writer,
                    "Valid records       : "
                            + result.productionValidRecords()
            );


            writeLine(
                    writer,
                    "Malformed records   : "
                            + result.productionInvalidRecords()
            );


            writer.newLine();


            writeLine(
                    writer,
                    "MIGRATED"
            );


            writeLine(
                    writer,
                    "------------------------------------------------------------"
            );


            writeLine(
                    writer,
                    "Total records       : "
                            + result.migratedTotalRecords()
            );


            writeLine(
                    writer,
                    "Valid records       : "
                            + result.migratedValidRecords()
            );


            writeLine(
                    writer,
                    "Malformed records   : "
                            + result.migratedInvalidRecords()
            );


            writer.newLine();


            writeLine(
                    writer,
                    "COMPARISON"
            );


            writeLine(
                    writer,
                    "------------------------------------------------------------"
            );


            writeLine(
                    writer,
                    "Exact matches              : "
                            + result.exactMatches()
            );


            writeLine(
                    writer,
                    "Logical records differing  : "
                            + result.probableMatches()
            );


            writeLine(
                    writer,
                    "Missing valid records      : "
                            + result.missingValidRecords()
            );


            writeLine(
                    writer,
                    "Extra valid records        : "
                            + result.extraValidRecords()
            );


            /*
             * ====================================================
             * COLUMN MISMATCH SUMMARY
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );


            writeLine(
                    writer,
                    "COLUMN MISMATCH SUMMARY"
            );


            writeLine(
                    writer,
                    "============================================================"
            );


            Map<String, Long> mismatchSummary =
                    result.recordDifferences()
                            .stream()
                            .flatMap(
                                    recordDifference ->
                                            recordDifference
                                                    .differences()
                                                    .stream()
                            )
                            .collect(
                                    Collectors.groupingBy(
                                            ColumnDifference::columnName,
                                            Collectors.counting()
                                    )
                            );


            mismatchSummary
                    .entrySet()
                    .stream()
                    .sorted(
                            Map.Entry
                                    .<String, Long>
                                            comparingByValue()
                                    .reversed()
                    )
                    .forEach(
                            entry -> {

                                try {

                                    writeLine(
                                            writer,
                                            String.format(
                                                    "%-25s : %d",
                                                    entry.getKey(),
                                                    entry.getValue()
                                            )
                                    );

                                } catch (IOException e) {

                                    throw new UncheckedIOException(
                                            e
                                    );
                                }
                            }
                    );


            /*
             * ====================================================
             * DETAILED FIELD DIFFERENCES
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );


            writeLine(
                    writer,
                    "DETAILED COLUMN DIFFERENCES"
            );


            writeLine(
                    writer,
                    "============================================================"
            );


            int detailCounter = 0;


            for (RecordDifference difference
                    : result.recordDifferences()) {


                if (detailCounter++
                        >= MAX_REPORT_EXAMPLES) {

                    writeLine(
                            writer,
                            "... REPORT LIMIT REACHED ..."
                    );

                    break;
                }


                writer.newLine();


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );


                writeLine(
                        writer,
                        "LOGICAL RECORD MATCH"
                );


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );


                /*
                 * Show configured key values.
                 */
                for (List<String> profile
                        : MATCH_PROFILES) {


                    writeLine(
                            writer,
                            "Matching key columns: "
                                    + profile
                    );


                    for (String keyColumn : profile) {


                        int index =
                                COLUMN_INDEX.get(
                                        keyColumn
                                );


                        writeLine(
                                writer,
                                keyColumn
                                        + " = ["
                                        + difference
                                        .production()
                                        .values()[index]
                                        + "]"
                        );
                    }


                    /*
                     * Normally only one profile is configured.
                     */
                    break;
                }


                writer.newLine();


                if (difference.differences().isEmpty()) {

                    writeLine(
                            writer,
                            "No data-column differences."
                    );

                    writeLine(
                            writer,
                            "Raw record formatting differs."
                    );

                } else {


                    for (ColumnDifference columnDifference
                            : difference.differences()) {


                        writeLine(
                                writer,
                                "Column #"
                                        + columnDifference.columnNumber()
                                        + " - "
                                        + columnDifference.columnName()
                        );


                        writeLine(
                                writer,
                                "Production : ["
                                        + columnDifference.productionValue()
                                        + "]"
                        );


                        writeLine(
                                writer,
                                "Migrated   : ["
                                        + columnDifference.migratedValue()
                                        + "]"
                        );


                        writer.newLine();
                    }
                }


                writeLine(
                        writer,
                        "Production record:"
                );


                writeLine(
                        writer,
                        difference
                                .production()
                                .rawLine()
                );


                writeLine(
                        writer,
                        "Migrated record:"
                );


                writeLine(
                        writer,
                        difference
                                .migrated()
                                .rawLine()
                );
            }


            /*
             * ====================================================
             * VALID RECORDS ONLY IN PRODUCTION
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );


            writeLine(
                    writer,
                    "VALID RECORDS ONLY IN PRODUCTION"
            );


            writeLine(
                    writer,
                    "============================================================"
            );


            result.remainingProduction()
                    .stream()
                    .limit(
                            MAX_REPORT_EXAMPLES
                    )
                    .forEach(
                            record -> {

                                try {

                                    writeLine(
                                            writer,
                                            record.rawLine()
                                    );

                                } catch (IOException e) {

                                    throw new UncheckedIOException(
                                            e
                                    );
                                }
                            }
                    );


            /*
             * ====================================================
             * VALID RECORDS ONLY IN MIGRATED
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );


            writeLine(
                    writer,
                    "VALID RECORDS ONLY IN MIGRATED"
            );


            writeLine(
                    writer,
                    "============================================================"
            );


            result.remainingMigrated()
                    .stream()
                    .limit(
                            MAX_REPORT_EXAMPLES
                    )
                    .forEach(
                            record -> {

                                try {

                                    writeLine(
                                            writer,
                                            record.rawLine()
                                    );

                                } catch (IOException e) {

                                    throw new UncheckedIOException(
                                            e
                                    );
                                }
                            }
                    );


            /*
             * ====================================================
             * MALFORMED PRODUCTION RECORDS
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );


            writeLine(
                    writer,
                    "MALFORMED PRODUCTION RECORDS"
            );


            writeLine(
                    writer,
                    "============================================================"
            );


            for (MalformedRecord malformed
                    : result.productionMalformedRecords()) {


                writer.newLine();


                writeLine(
                        writer,
                        "Original line number : "
                                + malformed.lineNumber()
                );


                writeLine(
                        writer,
                        "Expected columns     : "
                                + malformed.expectedColumns()
                );


                writeLine(
                        writer,
                        "Actual columns       : "
                                + malformed.actualColumns()
                );


                writeLine(
                        writer,
                        "Difference           : "
                                + formatColumnDifference(
                                        malformed
                                )
                );


                writeLine(
                        writer,
                        "Record:"
                );


                writeLine(
                        writer,
                        malformed.rawLine()
                );


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );
            }


            /*
             * ====================================================
             * MALFORMED MIGRATED RECORDS
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );


            writeLine(
                    writer,
                    "MALFORMED MIGRATED RECORDS"
            );


            writeLine(
                    writer,
                    "============================================================"
            );


            for (MalformedRecord malformed
                    : result.migratedMalformedRecords()) {


                writer.newLine();


                writeLine(
                        writer,
                        "Original line number : "
                                + malformed.lineNumber()
                );


                writeLine(
                        writer,
                        "Expected columns     : "
                                + malformed.expectedColumns()
                );


                writeLine(
                        writer,
                        "Actual columns       : "
                                + malformed.actualColumns()
                );


                writeLine(
                        writer,
                        "Difference           : "
                                + formatColumnDifference(
                                        malformed
                                )
                );


                writeLine(
                        writer,
                        "Record:"
                );


                writeLine(
                        writer,
                        malformed.rawLine()
                );


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );
            }
        }
    }


    /*
     * ============================================================
     * MALFORMED COLUMN COUNT DESCRIPTION
     * ============================================================
     */

    private static String formatColumnDifference(
            MalformedRecord record
    ) {

        int difference =
                record.actualColumns()
                        - record.expectedColumns();


        if (difference > 0) {

            return "+"
                    + difference
                    + " EXTRA COLUMN(S)";
        }


        if (difference < 0) {

            return Math.abs(
                    difference
            )
                    + " MISSING COLUMN(S)";
        }


        return "NONE";
    }


    private static void writeLine(
            BufferedWriter writer,
            String value
    ) throws IOException {

        writer.write(value);
        writer.newLine();
    }


    /*
     * ============================================================
     * EXTERNAL SORT
     * ============================================================
     */

    private static Path externalSort(
            Path inputFile,
            Path workingDirectory,
            String prefix
    ) throws IOException {


        List<Path> chunkFiles =
                new ArrayList<>();


        try (
                BufferedReader reader =
                        Files.newBufferedReader(
                                inputFile,
                                StandardCharsets.UTF_8
                        )
        ) {


            List<String> chunk =
                    new ArrayList<>(
                            SORT_CHUNK_SIZE
                    );


            String line;


            while ((line = reader.readLine()) != null) {


                chunk.add(
                        line
                );


                if (chunk.size()
                        >= SORT_CHUNK_SIZE) {


                    chunkFiles.add(
                            writeSortedChunk(
                                    chunk,
                                    workingDirectory,
                                    prefix
                            )
                    );


                    chunk =
                            new ArrayList<>(
                                    SORT_CHUNK_SIZE
                            );
                }
            }


            if (!chunk.isEmpty()) {


                chunkFiles.add(
                        writeSortedChunk(
                                chunk,
                                workingDirectory,
                                prefix
                        )
                );
            }
        }


        Path sortedOutput =
                workingDirectory.resolve(
                        prefix
                                + "_sorted.txt"
                );


        mergeSortedChunks(
                chunkFiles,
                sortedOutput
        );


        for (Path chunkFile
                : chunkFiles) {


            Files.deleteIfExists(
                    chunkFile
            );
        }


        return sortedOutput;
    }


    /*
     * ============================================================
     * WRITE SORTED CHUNK
     * ============================================================
     */

    private static Path writeSortedChunk(
            List<String> records,
            Path workingDirectory,
            String prefix
    ) throws IOException {


        Collections.sort(
                records
        );


        Path tempFile =
                Files.createTempFile(
                        workingDirectory,
                        prefix + "_chunk_",
                        ".tmp"
                );


        try (
                BufferedWriter writer =
                        Files.newBufferedWriter(
                                tempFile,
                                StandardCharsets.UTF_8
                        )
        ) {


            for (String record
                    : records) {


                writer.write(
                        record
                );

                writer.newLine();
            }
        }


        return tempFile;
    }


    /*
     * ============================================================
     * MERGE SORTED CHUNKS
     * ============================================================
     */

    private static void mergeSortedChunks(
            List<Path> chunkFiles,
            Path outputFile
    ) throws IOException {


        /*
         * Handle an empty input file.
         */
        if (chunkFiles.isEmpty()) {


            Files.writeString(
                    outputFile,
                    "",
                    StandardCharsets.UTF_8
            );


            return;
        }


        List<BufferedReader> readers =
                new ArrayList<>();


        PriorityQueue<MergeEntry> queue =
                new PriorityQueue<>(
                        Comparator.comparing(
                                MergeEntry::line
                        )
                );


        try {


            /*
             * Open each chunk.
             */
            for (int i = 0;
                 i < chunkFiles.size();
                 i++) {


                BufferedReader reader =
                        Files.newBufferedReader(
                                chunkFiles.get(i),
                                StandardCharsets.UTF_8
                        );


                readers.add(
                        reader
                );


                String firstLine =
                        reader.readLine();


                if (firstLine != null) {


                    queue.add(
                            new MergeEntry(
                                    firstLine,
                                    i
                            )
                    );
                }
            }


            try (
                    BufferedWriter writer =
                            Files.newBufferedWriter(
                                    outputFile,
                                    StandardCharsets.UTF_8
                            )
            ) {


                while (!queue.isEmpty()) {


                    MergeEntry entry =
                            queue.poll();


                    writer.write(
                            entry.line()
                    );

                    writer.newLine();


                    BufferedReader sourceReader =
                            readers.get(
                                    entry.readerIndex()
                            );


                    String nextLine =
                            sourceReader.readLine();


                    if (nextLine != null) {


                        queue.add(
                                new MergeEntry(
                                        nextLine,
                                        entry.readerIndex()
                                )
                        );
                    }
                }
            }


        } finally {


            for (BufferedReader reader
                    : readers) {


                try {

                    reader.close();

                } catch (IOException ignored) {
                }
            }
        }
    }


