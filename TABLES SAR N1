private List<Path> findAll(Path folder, String glob, List<String> excludes) throws IOException {

    List<Path> matches = new ArrayList<>();

    if (folder == null || !Files.isDirectory(folder)) {
        return matches;
    }

    try (DirectoryStream<Path> stream = Files.newDirectoryStream(folder, glob)) {

        for (Path path : stream) {

            String fileName = path.getFileName()
                    .toString()
                    .toUpperCase(Locale.ROOT);

            boolean excluded = false;

            for (String exclude : excludes) {
                if (fileName.contains(exclude.toUpperCase(Locale.ROOT))) {
                    excluded = true;
                    break;
                }
            }

            if (!excluded && Files.isRegularFile(path)) {
                matches.add(path);
            }
        }
    }

    if (matches.isEmpty()) {
        logger.info("WARN No files matched pattern '" + glob
                + "' under '" + folder + "'");
    } else {
        logger.info("Found " + matches.size()
                + " file(s) matching pattern '" + glob
                + "' under '" + folder + "'");
    }

    return matches;
}
