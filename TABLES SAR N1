public class Orchestrator {

    public static void main(String[] args) {

        if (args.length < 1) {
            System.err.println(
                    "Usage: java -jar orchestrator.jar <config-file>"
            );
            System.exit(1);
        }

        try {

            AppConfig.load(args[0]);

            System.out.println(
                    "Configuration loaded from: " + args[0]
            );

            MSSQLConnector connector =
                    new MSSQLConnector();

            // Continue orchestrator processing...

        } catch (Exception e) {

            e.printStackTrace();
            System.exit(1);
        }
    }
}


