import java.time.LocalDate;
import java.time.format.DateTimeFormatter;

public class FileDateExtractor {

    private static final DateTimeFormatter MMDDYYYY =
            DateTimeFormatter.ofPattern("MMddyyyy");

    private static final DateTimeFormatter MMDDYY =
            DateTimeFormatter.ofPattern("MMddyy");


    // --------------------------------------------------
    // BCS
    //
    // VB:
    // dteFile = CDate(
    //      Left(Mid(strFile, 14, 8), 2) & "/" &
    //      Mid(Mid(strFile, 14, 8), 3, 2) & "/" &
    //      Mid(Mid(strFile, 14, 8), 5, 4)
    // )
    // --------------------------------------------------
    public static LocalDate getBcsDate(String strFile) {

        // VB Mid(strFile, 14, 8)
        // Java starts at index 0, so position 14 => index 13
        String datePart = strFile.substring(13, 21);

        return LocalDate.parse(datePart, MMDDYYYY);
    }


    // --------------------------------------------------
    // BCOARB
    //
    // VB:
    // dteFile = CDate(
    //      Left(Right(strFile, 10), 2) & "/" &
    //      Mid(Right(strFile, 10), 3, 2) & "/" &
    //      Mid(Right(strFile, 10), 5, 2)
    // )
    //
    // Date is first 6 chars of last 10 chars = MMDDYY
    // --------------------------------------------------
    public static LocalDate getBcoarbDate(String strFile) {

        String last10 = strFile.substring(strFile.length() - 10);

        String datePart = last10.substring(0, 6);

        return LocalDate.parse(datePart, MMDDYY);
    }


    // --------------------------------------------------
    // BARBDIT022
    //
    // VB:
    // dteFile = CDate(
    //      Left(Right(strFile, 12), 2) & "/" &
    //      Mid(Right(strFile, 12), 3, 2) & "/" &
    //      Mid(Right(strFile, 12), 5, 4)
    // )
    //
    // Date is first 8 chars of last 12 chars = MMDDYYYY
    // --------------------------------------------------
    public static LocalDate getBarbdit022Date(String strFile) {

        String last12 = strFile.substring(strFile.length() - 12);

        String datePart = last12.substring(0, 8);

        return LocalDate.parse(datePart, MMDDYYYY);
    }


    // --------------------------------------------------
    // BARACON7
    //
    // VB:
    // dteFile = CDate(
    //      Left(Mid(strFile, 14, 8), 2) & "/" &
    //      Mid(Mid(strFile, 14, 8), 3, 2) & "/" &
    //      Mid(Mid(strFile, 14, 8), 5, 4)
    // )
    // --------------------------------------------------
    public static LocalDate getBaracon7Date(String strFile) {

        String datePart = strFile.substring(13, 21);

        return LocalDate.parse(datePart, MMDDYYYY);
    }


    // --------------------------------------------------
    // BARAPOP022 - Late Arrivals
    //
    // VB:
    // strMOD = Mid(strFile, InStr(strFile, ".") + 1, 8)
    //
    // dteMOD = CDate(
    //      Left(strMOD, 2) & "/" &
    //      Mid(strMOD, 3, 2) & "/" &
    //      Right(strMOD, 4)
    // )
    // --------------------------------------------------
    public static LocalDate getBarapop022Date(String strFile) {

        int dotIndex = strFile.indexOf('.');

        if (dotIndex < 0) {
            throw new IllegalArgumentException(
                    "Expected '.' in BARAPOP022 filename: " + strFile);
        }

        String datePart = strFile.substring(dotIndex + 1, dotIndex + 9);

        return LocalDate.parse(datePart, MMDDYYYY);
    }


    // --------------------------------------------------
    // Process Advisements
    //
    // VB:
    // ExportDateString =
    //      Left(strFile, 2) &
    //      Mid(strFile, 3, 2) &
    //      "20" &
    //      Mid(strFile, 5, 2)
    //
    // This returns MMDDYYYY as a String,
    // rather than a Date.
    // --------------------------------------------------
    public static String getProcessAdvisementsDateString(String strFile) {

        String month = strFile.substring(0, 2);
        String day   = strFile.substring(2, 4);
        String year  = strFile.substring(4, 6);

        return month + day + "20" + year;
    }
}
