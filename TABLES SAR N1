    ) {
    }


    /*
     * ============================================================
     * FINAL COMPARISON RESULT
     * ============================================================
     */

    public record ComparisonResult(

            long productionTotalRecords,
            long productionValidRecords,
            long productionInvalidRecords,

            long migratedTotalRecords,
            long migratedValidRecords,
            long migratedInvalidRecords,

            long exactMatches,

            long probableMatches,

            long missingValidRecords,
            long extraValidRecords,

            List<RecordDifference> recordDifferences,

            List<DataRecord> remainingProduction,
            List<DataRecord> remainingMigrated,

            List<MalformedRecord> productionMalformedRecords,
            List<MalformedRecord> migratedMalformedRecords

    ) {


        public boolean exactDataMatch() {


            return productionInvalidRecords == 0
                    &&
                    migratedInvalidRecords == 0
                    &&
                    probableMatches == 0
                    &&
                    missingValidRecords == 0
                    &&
                    extraValidRecords == 0
                    &&
                    productionValidRecords
                            == migratedValidRecords;
        }


        /*
         * ========================================================
         * PRINT CONSOLE SUMMARY
         * ========================================================
         */

        public void printSummary() {


            System.out.println();


            System.out.println(
                    "============================================================"
            );


            System.out.println(
                    "FILE COMPARISON SUMMARY"
            );


            System.out.println(
                    "============================================================"
            );


            System.out.println();


            System.out.println(
                    "PRODUCTION"
            );


            System.out.printf(
                    "Total records             : %,d%n",
                    productionTotalRecords
            );


            System.out.printf(
                    "Valid records             : %,d%n",
                    productionValidRecords
            );


            System.out.printf(
                    "Malformed records         : %,d%n",
                    productionInvalidRecords
            );


            System.out.println();


            System.out.println(
                    "MIGRATED"
            );


            System.out.printf(
                    "Total records             : %,d%n",
                    migratedTotalRecords
            );


            System.out.printf(
                    "Valid records             : %,d%n",
                    migratedValidRecords
            );


            System.out.printf(
                    "Malformed records         : %,d%n",
                    migratedInvalidRecords
            );


            System.out.println();


            System.out.println(
                    "COMPARISON"
            );


            System.out.printf(
                    "Exact matches             : %,d%n",
                    exactMatches
            );


            System.out.printf(
                    "Records with differences  : %,d%n",
                    probableMatches
            );


            System.out.printf(
                    "Missing valid records     : %,d%n",
                    missingValidRecords
            );


            System.out.printf(
                    "Extra valid records       : %,d%n",
                    extraValidRecords
            );


            System.out.println(
                    "------------------------------------------------------------"
            );


            if (exactDataMatch()) {


                System.out.println(
                        "RESULT: PASS"
                );


                System.out.println(
                        "All valid records match ignoring record order."
                );


            } else {


                System.out.println(
                        "RESULT: FAIL"
                );


                if (productionInvalidRecords > 0
                        ||
                        migratedInvalidRecords > 0) {


                    System.out.println(
                            "- Malformed records detected."
                    );
                }


                if (probableMatches > 0) {


                    System.out.println(
                            "- Logical records with differences detected."
                    );
                }


                if (missingValidRecords > 0) {


                    System.out.println(
                            "- Production records missing from migrated output."
                    );
                }


                if (extraValidRecords > 0) {


                    System.out.println(
                            "- Extra migrated records detected."
                    );
                }
            }


            System.out.println(
                    "============================================================"
            );
        }
    }


