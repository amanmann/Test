SELECT
    -- your other columns here

    N.Name1 AS Name1,
    LEFT(TRIM(N.Name1), 6) AS Zip

FROM dbo.[tbl_BAREDITO-22] T

CROSS APPLY
(
    SELECT
        CASE
            WHEN T.[account] IS NULL THEN NULL

            -- account contains only zeroes
            WHEN PATINDEX('%[^0]%', T.[account]) = 0 THEN ''

            -- remove zeroes only from the beginning
            ELSE SUBSTRING(
                T.[account],
                PATINDEX('%[^0]%', T.[account]),
                LEN(T.[account])
            )
        END AS Name1
) N;
