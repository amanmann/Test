/**
 * Moves a file to another directory.
 *
 * @param sourceFilePath     Source file
 * @param destinationFolder  Destination directory
 * @param newFileName        New filename; null/blank keeps original name
 * @param replaceExisting    If true, replaces existing destination file
 *                           If false, throws an exception if it exists
 */
public static Path moveFile(
        String sourceFilePath,
        String destinationFolder,
        String newFileName,
        boolean replaceExisting) throws IOException {

    Path source = Path.of(sourceFilePath);

    if (!Files.exists(source)) {
        throw new IOException(
                "Source file does not exist: " + sourceFilePath
        );
    }

    if (!Files.isRegularFile(source)) {
        throw new IOException(
                "Source is not a file: " + sourceFilePath
        );
    }

    Path destinationDir =
            checkAndCreatePath(destinationFolder);

    String destinationFileName =
            (newFileName == null || newFileName.isBlank())
                    ? source.getFileName().toString()
                    : newFileName;

    Path destination =
            destinationDir.resolve(destinationFileName);

    /*
     * Build move options based on configuration.
     */
    if (replaceExisting) {

        return Files.move(
                source,
                destination,
                StandardCopyOption.REPLACE_EXISTING
        );

    } else {

        /*
         * No REPLACE_EXISTING means an existing destination
         * will cause the move to fail.
         */
        return Files.move(
                source,
                destination
        );
    }
}
