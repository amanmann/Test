public MSSQLConnector() throws SQLException {

    String host =
            AppConfig.get("db.host");

    String port =
            AppConfig.get("db.port");

    String database =
            AppConfig.get("db.database");

    String username =
            AppConfig.get("db.username");

    String password =
            AppConfig.get("db.password");

    String url =
            "jdbc:jtds:sqlserver://" +
            host + ":" +
            port + "/" +
            database;

    this.connection =
            DriverManager.getConnection(
                    url,
                    username,
                    password
            );

    System.out.println(
            "Connected to MSSQL database."
    );
}
