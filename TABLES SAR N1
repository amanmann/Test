public class PipeFileComparator {

    /*
     * ============================================================
     * CONFIGURATION
     * ============================================================
     */

    private static final String DELIMITER = "\\|";

    private static final List<String> COLUMNS = List.of(
            "MMO",                 // 1
            "Priority",            // 2
            "State",               // 3
            "ClerkID",             // 4
            "CountryCode",         // 5
            "Currency",            // 6
            "EqCurrency",          // 7
            "Reason",              // 8
            "PageNumber",          // 9
            "Statement",           // 10
            "Branch",              // 11
            "PayeeNum",            // 12
            "TaxID",               // 13
            "Location",            // 14
            "RefNum",              // 15
            "RepSerialNum",        // 16
            "SerialNumber",        // 17
            "DCIP",                // 18
            "Zip",                 // 19
            "CustAcctNum",         // 20
            "ImageCode",           // 21
            "CPCS",                // 22
            "UserText1",           // 23
            "UserText2",           // 24
            "Addr1",               // 25
            "Addr2",               // 26
            "City",                // 27
            "Name1",               // 28
            "Name2",               // 29
            "Account",             // 30
            "Company",             // 31
            "Class",               // 32
            "Department",          // 33
            "Amount",              // 34
            "EqAmount",            // 35
            "UserAmount1",         // 36
            "AmountRecov",         // 37
            "AvgRate",             // 38
            "Aged",                // 39
