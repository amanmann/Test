import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

import java.io.BufferedReader;
import java.io.FileNotFoundException;
import java.io.FileReader;
import java.io.IOException;
import java.io.InputStream;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;

import java.util.stream.Collectors;
import java.util.stream.IntStream;

public static void loadFileToTable(
        String filePath,
        String tableName,
        Connection connection,
        String jsonConfigFileName)
        throws SQLException, IOException {

    // Load JSON configuration from resources
    InputStream inputStream =
            MSSQLConnector.class
                    .getClassLoader()
                    .getResourceAsStream(jsonConfigFileName);

    if (inputStream == null) {
        throw new FileNotFoundException(
                "JSON configuration file not found: "
                        + jsonConfigFileName);
    }

    ObjectMapper mapper = new ObjectMapper();

    JsonNode rootNode = mapper.readTree(inputStream);

    JsonNode tableConfig =
            rootNode.path("tables").path(tableName);

    if (tableConfig.isMissingNode()) {
        throw new IllegalArgumentException(
                "Table configuration not found for: "
                        + tableName);
    }

    JsonNode columns =
            tableConfig.path("columns");

    int columnCount =
            columns.size();


    /*
     * Build:
     *
     * INSERT INTO tableName
     * ([Column1], [Column 2], [Column3])
     * VALUES (?, ?, ?)
     *
     * Only change from your previous implementation:
     * ALL column names are surrounded with [ ].
     */
    String insertQuery =
            "INSERT INTO "
                    + tableName
                    + " ("
                    + IntStream.range(0, columnCount)
                    .mapToObj(i ->
                            "["
                                    + columns
                                    .get(i)
                                    .path("name")
                                    .asText()
                                    + "]")
                    .collect(Collectors.joining(","))
                    + ") VALUES ("
                    + "?,".repeat(columnCount - 1)
                    + "?"
                    + ")";


    try (
            BufferedReader reader =
                    new BufferedReader(
                            new FileReader(filePath));

            PreparedStatement pstmt =
                    connection.prepareStatement(insertQuery)
    ) {

        String line;

        while ((line = reader.readLine()) != null) {

            /*
             * Preserve trailing empty values.
             */
            String[] values =
                    line.split("\\|", -1);


            if (values.length != columnCount) {
                throw new IllegalArgumentException(
                        "Column count mismatch for table: "
                                + tableName
                                + ". Expected "
                                + columnCount
                                + " but found "
                                + values.length);
            }


            for (int i = 0; i < columnCount; i++) {

                JsonNode column =
                        columns.get(i);

                String type =
                        column
                                .path("type")
                                .asText()
                                .toUpperCase();

                String value =
                        values[i] == null
                                ? ""
                                : values[i].trim();


                if (value.isEmpty()) {

                    pstmt.setNull(
                            i + 1,
                            getSqlType(type));

                } else {

                    setPreparedStatementValue(
                            pstmt,
                            i + 1,
                            value,
                            type);
                }
            }


            pstmt.addBatch();
        }


        pstmt.executeBatch();
    }


    System.out.println(
            "File data loaded into table: "
                    + tableName);
}
