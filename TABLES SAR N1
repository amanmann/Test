List<String> flowExecutionList =
        Arrays.stream(AppConfig.get("FLOW_EXECUTION_LIST").split(","))
                .map(String::trim)
                .filter(s -> !s.isEmpty())
                .toList();

for (String flow : flowExecutionList) {

    try {
        logger.info("Starting flow: {}", flow);

        switch (flow.toUpperCase()) {

            case "SAR_N1":
                Process.SAR_N1_Orchestrator(connector);
                break;

            case "SAR_S1":
                Process.SAR_S1_Orchestrator(connector);
                break;

            case "SAR_S1_LATEARRIVALS":
                Process.SAR_S1_LateArrivals_Orchestrator(connector);
                break;

            case "MC_ADVISEMENTS":
                Process.MC_Advisements_Orchestrator(connector);
                break;

            default:
                logger.warn("Unknown flow in FLOW_EXECUTION_LIST: {}", flow);
                break;
        }

        logger.info("Completed flow: {}", flow);

    } catch (Exception e) {

        logger.error(
                "Flow {} failed. Continuing with remaining flows.",
                flow,
                e
        );
    }
}
