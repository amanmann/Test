import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;
import java.sql.CallableStatement;
import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.sql.SQLException;

public void writeStoredProcedureOutputToFile(
        String procedureName,
        String outputFilePath,
        Object... params) throws SQLException, IOException {

    StringBuilder callQuery = new StringBuilder("{CALL " + procedureName + "(");

    for (int i = 0; i < params.length; i++) {
        callQuery.append("?");
        if (i < params.length - 1) {
            callQuery.append(",");
        }
    }

    callQuery.append(")}");

    try (CallableStatement stmt = connection.prepareCall(callQuery.toString());
         BufferedWriter writer = new BufferedWriter(new FileWriter(outputFilePath))) {

        // Set SP parameters, if there are any
        for (int i = 0; i < params.length; i++) {
            stmt.setObject(i + 1, params[i]);
        }

        boolean hasResults = stmt.execute();

        // Handles both update counts and result sets.
        while (true) {
            if (hasResults) {
                try (ResultSet rs = stmt.getResultSet()) {
                    ResultSetMetaData metaData = rs.getMetaData();
                    int columnCount = metaData.getColumnCount();

                    // No column headers.
                    // No commas added by Java.
                    // The SP-provided Delim1...Delim46 values supply '|'.
                    while (rs.next()) {
                        for (int i = 1; i <= columnCount; i++) {
                            String value = rs.getString(i);
                            writer.write(value == null ? "" : value);
                        }
                        writer.newLine();
                    }
                }
            } else {
                int updateCount = stmt.getUpdateCount();

                // No further result set or update count exists.
                if (updateCount == -1) {
                    break;
                }
            }

            hasResults = stmt.getMoreResults();
        }

        writer.flush();
    }

    System.out.println("Stored procedure output written to file: " + outputFilePath);
}
