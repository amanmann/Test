package com.comparator;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.stream.Collectors;

public class PipeFileComparator {

    /*
     * ============================================================
     * CONFIGURATION
     * ============================================================
     */

    private static final String DELIMITER_REGEX = "\\|";

    private static final int EXPECTED_COLUMN_COUNT = 46;

    /*
     * Change ONLY this configuration if you want different
     * matching key columns.
     *
     * Examples:
     *
     * List.of(List.of("Account"))
     *
     * List.of(List.of("Account", "RefNum"))
     *
     * List.of(List.of("Account", "EffectiveDate"))
     */
    private static final List<List<String>> MATCH_PROFILES =
            List.of(List.of("Account"));

    /*
     * A probable logical match is accepted only when at most
     * this many columns differ.
     */
    private static final int MAX_DIFFERENT_COLUMNS = 2;

    /*
     * Only unmatched VALID records enter fuzzy comparison.
     * This prevents accidentally loading enormous mismatch
     * sets into memory.
     */
    private static final int MAX_FUZZY_RECORDS = 500_000;

    private static final int MAX_REPORT_EXAMPLES = 10_000;

    /*
     * Number of records sorted in memory at a time.
     */
    private static final int SORT_CHUNK_SIZE = 250_000;


    /*
     * ============================================================
     * COLUMN DEFINITIONS
     * ============================================================
     */

    private static final List<String> COLUMNS = List.of(
            "MMO",                 // 1
            "Priority",            // 2
            "State",               // 3
            "ClerkID",             // 4
            "CountryCode",         // 5
            "Currency",            // 6
            "EqCurrency",          // 7
            "Reason",              // 8
            "PageNumber",          // 9
            "Statement",           // 10
            "Branch",              // 11
            "PayeeNum",            // 12
            "TaxID",               // 13
            "Location",            // 14
            "RefNum",              // 15
            "RepSerialNum",        // 16
            "SerialNumber",        // 17
            "DCIP",                // 18
            "Zip",                 // 19
            "CustAcctNum",         // 20
            "ImageCode",           // 21
            "CPCS",                // 22
            "UserText1",           // 23
            "UserText2",           // 24
            "Addr1",               // 25
            "Addr2",               // 26
            "City",                // 27
            "Name1",               // 28
            "Name2",               // 29
            "Account",             // 30
            "Company",             // 31
            "Class",               // 32
            "Department",          // 33
            "Amount",              // 34
            "EqAmount",            // 35
            "UserAmount1",         // 36
            "AmountRecov",         // 37
            "AvgRate",             // 38
            "Aged",                // 39
            "DaysRecovered",       // 40
            "UserNum1",            // 41
            "UserNum2",            // 42
            "AvailOrPaid",         // 43
            "EffectiveDate",       // 44
            "PostedOrIssue",       // 45
            "EqDate"               // 46
    );


    private static final Map<String, Integer> COLUMN_INDEX =
            createColumnIndex();


    private static Map<String, Integer> createColumnIndex() {

        Map<String, Integer> result = new HashMap<>();

        for (int i = 0; i < COLUMNS.size(); i++) {
            result.put(COLUMNS.get(i), i);
        }

        return Collections.unmodifiableMap(result);
    }


    /*
     * ============================================================
     * MAIN COMPARISON
     * ============================================================
     */

    public static ComparisonResult compare(
            Path productionFile,
            Path migratedFile,
            Path workingDirectory,
            Path reportFile
    ) throws IOException {

        Files.createDirectories(workingDirectory);

        /*
         * --------------------------------------------------------
         * STEP 1
         *
         * Validate the structure of every line BEFORE comparison.
         *
         * Only records with exactly 46 columns are placed in the
         * valid files.
         *
         * Bad records are stored separately and comparison
         * continues.
         * --------------------------------------------------------
         */

        Path validProduction =
                workingDirectory.resolve("valid_production.txt");

        Path validMigrated =
                workingDirectory.resolve("valid_migrated.txt");


        ValidationResult productionValidation =
                validateAndSeparate(
                        productionFile,
                        validProduction,
                        "PRODUCTION"
                );


        ValidationResult migratedValidation =
                validateAndSeparate(
                        migratedFile,
                        validMigrated,
                        "MIGRATED"
                );


        /*
         * --------------------------------------------------------
         * STEP 2
         *
         * Sort only structurally valid records.
         * --------------------------------------------------------
         */

        Path prodSorted =
                externalSort(
                        validProduction,
                        workingDirectory,
                        "prod"
                );


        Path migratedSorted =
                externalSort(
                        validMigrated,
                        workingDirectory,
                        "migrated"
                );


        Path unmatchedProd =
                workingDirectory.resolve(
                        "unmatched_production.txt"
                );


        Path unmatchedMigrated =
                workingDirectory.resolve(
                        "unmatched_migrated.txt"
                );


        /*
         * --------------------------------------------------------
         * STEP 3
         *
         * Exact order-independent comparison.
         * --------------------------------------------------------
         */

        ExactComparisonResult exactResult =
                exactCompare(
                        prodSorted,
                        migratedSorted,
                        unmatchedProd,
                        unmatchedMigrated
                );


        /*
         * --------------------------------------------------------
         * STEP 4
         *
         * Analyze valid unmatched records at column level.
         * --------------------------------------------------------
         */

        FuzzyComparisonResult fuzzyResult =
                fuzzyCompare(
                        unmatchedProd,
                        unmatchedMigrated
                );


        ComparisonResult result =
                new ComparisonResult(

                        productionValidation.totalRecords(),
                        productionValidation.validRecords(),
                        productionValidation.invalidRecords(),

                        migratedValidation.totalRecords(),
                        migratedValidation.validRecords(),
                        migratedValidation.invalidRecords(),

                        exactResult.exactMatches(),

                        fuzzyResult.probableMatches().size(),

                        fuzzyResult.remainingProduction().size(),
                        fuzzyResult.remainingMigrated().size(),

                        fuzzyResult.probableMatches(),

                        fuzzyResult.remainingProduction(),
                        fuzzyResult.remainingMigrated(),

                        productionValidation.malformedRecords(),
                        migratedValidation.malformedRecords()
                );


        /*
         * --------------------------------------------------------
         * STEP 5
         *
         * Generate detailed report.
         * --------------------------------------------------------
         */

        writeReport(
                result,
                reportFile
        );


        /*
         * Cleanup large temporary sorted files.
         */

        Files.deleteIfExists(prodSorted);
        Files.deleteIfExists(migratedSorted);


        return result;
    }


    /*
     * ============================================================
     * FILE STRUCTURE VALIDATION
     * ============================================================
     */

    private static ValidationResult validateAndSeparate(
            Path sourceFile,
            Path validOutputFile,
            String sourceName
    ) throws IOException {

        long totalRecords = 0;
        long validRecords = 0;
        long invalidRecords = 0;

        List<MalformedRecord> malformedRecords =
                new ArrayList<>();


        try (
                BufferedReader reader =
                        Files.newBufferedReader(
                                sourceFile,
                                StandardCharsets.UTF_8
                        );

                BufferedWriter validWriter =
                        Files.newBufferedWriter(
                                validOutputFile,
                                StandardCharsets.UTF_8
                        )
        ) {

            String line;

            long lineNumber = 0;


            while ((line = reader.readLine()) != null) {

                lineNumber++;
                totalRecords++;


                String[] values =
                        line.split(
                                DELIMITER_REGEX,
                                -1
                        );


                if (values.length == EXPECTED_COLUMN_COUNT) {

                    validWriter.write(line);
                    validWriter.newLine();

                    validRecords++;

                } else {

                    invalidRecords++;


                    /*
                     * Keep malformed records separately.
                     *
                     * Comparison does NOT stop.
                     */
                    if (malformedRecords.size()
                            < MAX_REPORT_EXAMPLES) {

                        malformedRecords.add(
                                new MalformedRecord(
                                        sourceName,
                                        lineNumber,
                                        EXPECTED_COLUMN_COUNT,
                                        values.length,
                                        line
                                )
                        );
                    }
                }
            }
        }


        return new ValidationResult(
                totalRecords,
                validRecords,
                invalidRecords,
                malformedRecords
        );
    }


    /*
     * ============================================================
     * EXACT ORDER-INDEPENDENT COMPARISON
     * ============================================================
     */

    private static ExactComparisonResult exactCompare(
            Path prodSorted,
            Path migratedSorted,
            Path unmatchedProd,
            Path unmatchedMigrated
    ) throws IOException {

        long exactMatches = 0;


        try (
                BufferedReader prodReader =
                        Files.newBufferedReader(
                                prodSorted,
                                StandardCharsets.UTF_8
                        );

                BufferedReader migratedReader =
                        Files.newBufferedReader(
                                migratedSorted,
                                StandardCharsets.UTF_8
                        );

                BufferedWriter prodUnmatchedWriter =
                        Files.newBufferedWriter(
                                unmatchedProd,
                                StandardCharsets.UTF_8
                        );

                BufferedWriter migratedUnmatchedWriter =
                        Files.newBufferedWriter(
                                unmatchedMigrated,
                                StandardCharsets.UTF_8
                        )
        ) {

            String prod =
                    prodReader.readLine();

            String migrated =
                    migratedReader.readLine();


            while (prod != null || migrated != null) {

                /*
                 * Migrated still has records,
                 * production is exhausted.
                 */
                if (prod == null) {

                    migratedUnmatchedWriter.write(migrated);
                    migratedUnmatchedWriter.newLine();

                    migrated =
                            migratedReader.readLine();

                    continue;
                }


                /*
                 * Production still has records,
                 * migrated is exhausted.
                 */
                if (migrated == null) {

                    prodUnmatchedWriter.write(prod);
                    prodUnmatchedWriter.newLine();

                    prod =
                            prodReader.readLine();

                    continue;
                }


                int comparison =
                        prod.compareTo(migrated);


                /*
                 * Exact record match.
                 */
                if (comparison == 0) {

                    exactMatches++;

                    prod =
                            prodReader.readLine();

                    migrated =
                            migratedReader.readLine();

                }

                /*
                 * Production record not currently
                 * present in migrated data.
                 */
                else if (comparison < 0) {

                    prodUnmatchedWriter.write(prod);
                    prodUnmatchedWriter.newLine();

                    prod =
                            prodReader.readLine();

                }

                /*
                 * Migrated record not currently
                 * present in production.
                 */
                else {

                    migratedUnmatchedWriter.write(migrated);
                    migratedUnmatchedWriter.newLine();

                    migrated =
                            migratedReader.readLine();
                }
            }
        }


        return new ExactComparisonResult(
                exactMatches
        );
    }


    /*
     * ============================================================
     * FUZZY / COLUMN LEVEL COMPARISON
     * ============================================================
     */

    private static FuzzyComparisonResult fuzzyCompare(
            Path unmatchedProdFile,
            Path unmatchedMigratedFile
    ) throws IOException {

        List<DataRecord> production =
                readValidRecords(
                        unmatchedProdFile
                );


        List<DataRecord> migrated =
                readValidRecords(
                        unmatchedMigratedFile
                );


        /*
         * Safety check.
         */
        if (production.size() > MAX_FUZZY_RECORDS
                || migrated.size() > MAX_FUZZY_RECORDS) {

            throw new IllegalStateException(
                    """
                    Too many unmatched VALID records for fuzzy comparison.

                    Production unmatched: %d
                    Migrated unmatched:   %d

                    This indicates a large difference between the files.
                    Increase MAX_FUZZY_RECORDS only if this is expected.
                    """
                            .formatted(
                                    production.size(),
                                    migrated.size()
                            )
            );
        }


        /*
         * Build one index for each configured matching profile.
         */
        List<Map<String, List<DataRecord>>> migratedIndexes =
                new ArrayList<>();


        for (List<String> profile : MATCH_PROFILES) {

            migratedIndexes.add(
                    buildIndex(
                            migrated,
                            profile
                    )
            );
        }


        /*
         * Prevent one migrated record from being matched
         * against more than one production record.
         */
        Set<Long> usedMigratedRecordIds =
                new HashSet<>();


        List<RecordDifference> probableMatches =
                new ArrayList<>();


        List<DataRecord> remainingProduction =
                new ArrayList<>();


        /*
         * ========================================================
         * Process each production mismatch.
         * ========================================================
         */

        for (DataRecord productionRecord : production) {

            Set<DataRecord> candidates =
                    new LinkedHashSet<>();


            /*
             * Find migrated candidates using configured key(s).
             */
            for (int profileIndex = 0;
                 profileIndex < MATCH_PROFILES.size();
                 profileIndex++) {

                List<String> profile =
                        MATCH_PROFILES.get(profileIndex);


                String key =
                        buildKey(
                                productionRecord,
                                profile
                        );


                if (key.isBlank()) {
                    continue;
                }


                List<DataRecord> matchingCandidates =
                        migratedIndexes
                                .get(profileIndex)
                                .getOrDefault(
                                        key,
                                        Collections.emptyList()
                                );


                for (DataRecord candidate
                        : matchingCandidates) {

                    if (!usedMigratedRecordIds
                            .contains(candidate.id())) {

                        candidates.add(candidate);
                    }
                }
            }


            DataRecord bestCandidate = null;

            List<ColumnDifference> bestDifferences = null;


            /*
             * Compare candidate records column-by-column.
             */
            for (DataRecord candidate : candidates) {

                List<ColumnDifference> differences =
                        findDifferences(
                                productionRecord,
                                candidate
                        );


                /*
                 * Only call it a probable logical match
                 * if very few columns differ.
                 */
                if (differences.size()
                        <= MAX_DIFFERENT_COLUMNS) {

                    if (bestCandidate == null
                            || differences.size()
                            < bestDifferences.size()) {

                        bestCandidate =
                                candidate;

                        bestDifferences =
                                differences;
                    }
                }
            }


            /*
             * Logical record found.
             */
            if (bestCandidate != null) {

                usedMigratedRecordIds.add(
                        bestCandidate.id()
                );


                probableMatches.add(
                        new RecordDifference(
                                productionRecord,
                                bestCandidate,
                                bestDifferences
                        )
                );

            } else {

                /*
                 * No safe corresponding record found.
                 */
                remainingProduction.add(
                        productionRecord
                );
            }
        }


        /*
         * Anything not consumed from migrated side
         * is considered an extra record.
         */
        List<DataRecord> remainingMigrated =
                migrated.stream()
                        .filter(
                                record ->
                                        !usedMigratedRecordIds
                                                .contains(
                                                        record.id()
                                                )
                        )
                        .toList();


        return new FuzzyComparisonResult(
                probableMatches,
                remainingProduction,
                remainingMigrated
        );
    }


    /*
     * ============================================================
     * COLUMN DIFFERENCE DETECTION
     * ============================================================
     */

    private static List<ColumnDifference> findDifferences(
            DataRecord production,
            DataRecord migrated
    ) {

        List<ColumnDifference> differences =
                new ArrayList<>();


        for (int i = 0;
             i < COLUMNS.size();
             i++) {

            String productionValue =
                    production.values()[i];


            String migratedValue =
                    migrated.values()[i];


            if (!Objects.equals(
                    productionValue,
                    migratedValue
            )) {

                differences.add(
                        new ColumnDifference(
                                i + 1,
                                COLUMNS.get(i),
                                productionValue,
                                migratedValue
                        )
                );


                /*
                 * We only need to know that the number
                 * exceeded the allowed mismatch threshold.
                 */
                if (differences.size()
                        > MAX_DIFFERENT_COLUMNS) {

                    break;
                }
            }
        }


        return differences;
    }


    /*
     * ============================================================
     * INDEX CREATION
     * ============================================================
     */

    private static Map<String, List<DataRecord>> buildIndex(
            List<DataRecord> records,
            List<String> keyColumns
    ) {

        Map<String, List<DataRecord>> index =
                new HashMap<>();


        for (DataRecord record : records) {

            String key =
                    buildKey(
                            record,
                            keyColumns
                    );


            if (key.isBlank()) {
                continue;
            }


            index.computeIfAbsent(
                    key,
                    ignored -> new ArrayList<>()
            ).add(record);
        }


        return index;
    }


    /*
     * ============================================================
     * BUILD CONFIGURABLE RECORD KEY
     * ============================================================
     */

    private static String buildKey(
            DataRecord record,
            List<String> keyColumns
    ) {

        StringBuilder result =
                new StringBuilder();


        boolean hasAtLeastOneValue =
                false;


        for (String columnName : keyColumns) {

            Integer index =
                    COLUMN_INDEX.get(columnName);


            if (index == null) {

                throw new IllegalArgumentException(
                        "Unknown key column: "
                                + columnName
                );
            }


            String value =
                    record.values()[index];


            if (value != null
                    && !value.isBlank()) {

                hasAtLeastOneValue =
                        true;
            }


            /*
             * Separator unlikely to exist in normal data.
             */
            result.append(
                    normalizeKeyValue(value)
            );

            result.append('\u0001');
        }


        if (!hasAtLeastOneValue) {
            return "";
        }


        return result.toString();
    }


    private static String normalizeKeyValue(
            String value
    ) {

        if (value == null) {
            return "";
        }


        return value.trim();
    }


    /*
     * ============================================================
     * READ STRUCTURALLY VALID RECORDS
     * ============================================================
     */

    private static List<DataRecord> readValidRecords(
            Path file
    ) throws IOException {

        List<DataRecord> records =
                new ArrayList<>();


        try (BufferedReader reader =
                     Files.newBufferedReader(
                             file,
                             StandardCharsets.UTF_8
                     )) {

            String line;

            long id = 0;


            while ((line = reader.readLine()) != null) {

                id++;


                String[] values =
                        line.split(
                                DELIMITER_REGEX,
                                -1
                        );


                /*
                 * This should never normally happen because
                 * malformed rows were already separated.
                 *
                 * However, do NOT crash even here.
                 */
                if (values.length
                        != EXPECTED_COLUMN_COUNT) {

                    continue;
                }


                records.add(
                        new DataRecord(
                                id,
                                line,
                                values
                        )
                );
            }
        }


        return records;
    }


    /*
     * ============================================================
     * REPORT GENERATION
     * ============================================================
     */

    private static void writeReport(
            ComparisonResult result,
            Path reportFile
    ) throws IOException {

        try (BufferedWriter writer =
                     Files.newBufferedWriter(
                             reportFile,
                             StandardCharsets.UTF_8
                     )) {


            /*
             * ====================================================
             * SUMMARY
             * ====================================================
             */

            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "FILE COMPARISON REPORT"
            );

            writeLine(
                    writer,
                    "============================================================"
            );

            writer.newLine();


            writeLine(
                    writer,
                    "PRODUCTION"
            );

            writeLine(
                    writer,
                    "------------------------------------------------------------"
            );


            writeLine(
                    writer,
                    "Total records       : "
                            + result.productionTotalRecords()
            );


            writeLine(
                    writer,
                    "Valid records       : "
                            + result.productionValidRecords()
            );


            writeLine(
                    writer,
                    "Malformed records   : "
                            + result.productionInvalidRecords()
            );


            writer.newLine();


            writeLine(
                    writer,
                    "MIGRATED"
            );

            writeLine(
                    writer,
                    "------------------------------------------------------------"
            );


            writeLine(
                    writer,
                    "Total records       : "
                            + result.migratedTotalRecords()
            );


            writeLine(
                    writer,
                    "Valid records       : "
                            + result.migratedValidRecords()
            );


            writeLine(
                    writer,
                    "Malformed records   : "
                            + result.migratedInvalidRecords()
            );


            writer.newLine();


            writeLine(
                    writer,
                    "VALID RECORD COMPARISON"
            );

            writeLine(
                    writer,
                    "------------------------------------------------------------"
            );


            writeLine(
                    writer,
                    "Exact matches            : "
                            + result.exactMatches()
            );


            writeLine(
                    writer,
                    "Records with differences : "
                            + result.probableMatches()
            );


            writeLine(
                    writer,
                    "Missing valid records    : "
                            + result.missingValidRecords()
            );


            writeLine(
                    writer,
                    "Extra valid records      : "
                            + result.extraValidRecords()
            );


            /*
             * ====================================================
             * COLUMN MISMATCH SUMMARY
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "COLUMN MISMATCH SUMMARY"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            Map<String, Long> mismatchSummary =
                    result.recordDifferences()
                            .stream()
                            .flatMap(
                                    difference ->
                                            difference
                                                    .differences()
                                                    .stream()
                            )
                            .collect(
                                    Collectors.groupingBy(
                                            ColumnDifference::columnName,
                                            Collectors.counting()
                                    )
                            );


            List<Map.Entry<String, Long>>
                    sortedMismatchSummary =
                    mismatchSummary
                            .entrySet()
                            .stream()
                            .sorted(
                                    Map.Entry
                                            .<String, Long>
                                                    comparingByValue()
                                            .reversed()
                            )
                            .toList();


            for (Map.Entry<String, Long> entry
                    : sortedMismatchSummary) {

                writeLine(
                        writer,
                        String.format(
                                "%-25s : %d",
                                entry.getKey(),
                                entry.getValue()
                        )
                );
            }


            /*
             * ====================================================
             * DETAILED COLUMN DIFFERENCES
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "DETAILED COLUMN DIFFERENCES"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            int count = 0;


            for (RecordDifference difference
                    : result.recordDifferences()) {

                if (count++
                        >= MAX_REPORT_EXAMPLES) {

                    writeLine(
                            writer,
                            "... report limit reached ..."
                    );

                    break;
                }


                writer.newLine();


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );


                writeLine(
                        writer,
                        "PROBABLE LOGICAL RECORD MATCH"
                );


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );


                /*
                 * Show configured key values.
                 */
                for (List<String> profile
                        : MATCH_PROFILES) {

                    writeLine(
                            writer,
                            "Matching profile: "
                                    + profile
                    );

                    break;
                }


                for (ColumnDifference columnDifference
                        : difference.differences()) {

                    writer.newLine();


                    writeLine(
                            writer,
                            "Column #"
                                    + columnDifference.columnNumber()
                                    + " - "
                                    + columnDifference.columnName()
                    );


                    writeLine(
                            writer,
                            "Production : ["
                                    + columnDifference.productionValue()
                                    + "]"
                    );


                    writeLine(
                            writer,
                            "Migrated   : ["
                                    + columnDifference.migratedValue()
                                    + "]"
                    );
                }


                writer.newLine();


                writeLine(
                        writer,
                        "Production record:"
                );


                writeLine(
                        writer,
                        difference
                                .production()
                                .rawLine()
                );


                writeLine(
                        writer,
                        "Migrated record:"
                );


                writeLine(
                        writer,
                        difference
                                .migrated()
                                .rawLine()
                );
            }


            /*
             * ====================================================
             * VALID RECORDS ONLY IN PRODUCTION
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "VALID RECORDS ONLY IN PRODUCTION"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            result.remainingProduction()
                    .stream()
                    .limit(MAX_REPORT_EXAMPLES)
                    .forEach(
                            record -> {
                                try {
                                    writeLine(
                                            writer,
                                            record.rawLine()
                                    );
                                } catch (IOException e) {
                                    throw new UncheckedIOException(e);
                                }
                            }
                    );


            /*
             * ====================================================
             * VALID RECORDS ONLY IN MIGRATED
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "VALID RECORDS ONLY IN MIGRATED OUTPUT"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            result.remainingMigrated()
                    .stream()
                    .limit(MAX_REPORT_EXAMPLES)
                    .forEach(
                            record -> {
                                try {
                                    writeLine(
                                            writer,
                                            record.rawLine()
                                    );
                                } catch (IOException e) {
                                    throw new UncheckedIOException(e);
                                }
                            }
                    );


            /*
             * ====================================================
             * MALFORMED PRODUCTION RECORDS
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "MALFORMED PRODUCTION RECORDS"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            for (MalformedRecord malformedRecord
                    : result.productionMalformedRecords()) {

                writer.newLine();


                writeLine(
                        writer,
                        "Line number       : "
                                + malformedRecord.lineNumber()
                );


                writeLine(
                        writer,
                        "Expected columns  : "
                                + malformedRecord.expectedColumns()
                );


                writeLine(
                        writer,
                        "Actual columns    : "
                                + malformedRecord.actualColumns()
                );


                writeLine(
                        writer,
                        "Difference        : "
                                + formatColumnDifference(
                                        malformedRecord
                                )
                );


                writeLine(
                        writer,
                        "Record:"
                );


                writeLine(
                        writer,
                        malformedRecord.rawLine()
                );


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );
            }


            /*
             * ====================================================
             * MALFORMED MIGRATED RECORDS
             * ====================================================
             */

            writer.newLine();
            writer.newLine();


            writeLine(
                    writer,
                    "============================================================"
            );

            writeLine(
                    writer,
                    "MALFORMED MIGRATED RECORDS"
            );

            writeLine(
                    writer,
                    "============================================================"
            );


            for (MalformedRecord malformedRecord
                    : result.migratedMalformedRecords()) {

                writer.newLine();


                writeLine(
                        writer,
                        "Line number       : "
                                + malformedRecord.lineNumber()
                );


                writeLine(
                        writer,
                        "Expected columns  : "
                                + malformedRecord.expectedColumns()
                );


                writeLine(
                        writer,
                        "Actual columns    : "
                                + malformedRecord.actualColumns()
                );


                writeLine(
                        writer,
                        "Difference        : "
                                + formatColumnDifference(
                                        malformedRecord
                                )
                );


                writeLine(
                        writer,
                        "Record:"
                );


                writeLine(
                        writer,
                        malformedRecord.rawLine()
                );


                writeLine(
                        writer,
                        "------------------------------------------------------------"
                );
            }
        }
    }


    private static String formatColumnDifference(
            MalformedRecord record
    ) {

        int difference =
                record.actualColumns()
                        - record.expectedColumns();


        if (difference > 0) {

            return "+"
                    + difference
                    + " EXTRA column(s)";
        }


        return Math.abs(difference)
                + " MISSING column(s)";
    }


    private static void writeLine(
            BufferedWriter writer,
            String value
    ) throws IOException {

        writer.write(value);
        writer.newLine();
    }


    /*
     * ============================================================
     * EXTERNAL SORT
     * ============================================================
     */

    private static Path externalSort(
            Path inputFile,
            Path workingDirectory,
            String prefix
    ) throws IOException {

        List<Path> chunkFiles =
                new ArrayList<>();


        try (BufferedReader reader =
                     Files.newBufferedReader(
                             inputFile,
                             StandardCharsets.UTF_8
                     )) {

            List<String> chunk =
                    new ArrayList<>(
                            SORT_CHUNK_SIZE
                    );


            String line;


            while ((line = reader.readLine()) != null) {

                chunk.add(line);


                if (chunk.size()
                        >= SORT_CHUNK_SIZE) {

                    chunkFiles.add(
                            writeSortedChunk(
                                    chunk,
                                    workingDirectory,
                                    prefix
                            )
                    );


                    chunk =
                            new ArrayList<>(
                                    SORT_CHUNK_SIZE
                            );
                }
            }


            if (!chunk.isEmpty()) {

                chunkFiles.add(
                        writeSortedChunk(
                                chunk,
                                workingDirectory,
                                prefix
                        )
                );
            }
        }


        Path sortedOutput =
                workingDirectory.resolve(
                        prefix + "_sorted.txt"
                );


        mergeSortedChunks(
                chunkFiles,
                sortedOutput
        );


        /*
         * Delete individual sorted chunks after merge.
         */
        for (Path chunkFile : chunkFiles) {

            Files.deleteIfExists(
                    chunkFile
            );
        }


        return sortedOutput;
    }


    private static Path writeSortedChunk(
            List<String> records,
            Path workingDirectory,
            String prefix
    ) throws IOException {

        Collections.sort(records);


        Path tempFile =
                Files.createTempFile(
                        workingDirectory,
                        prefix + "_chunk_",
                        ".tmp"
                );


        try (BufferedWriter writer =
                     Files.newBufferedWriter(
                             tempFile,
                             StandardCharsets.UTF_8
                     )) {

            for (String record : records) {

                writer.write(record);
                writer.newLine();
            }
        }


        return tempFile;
    }


    /*
     * ============================================================
     * MERGE SORTED CHUNKS
     * ============================================================
     */

    private static void mergeSortedChunks(
            List<Path> chunkFiles,
            Path outputFile
    ) throws IOException {

        /*
         * Empty source file.
         */
        if (chunkFiles.isEmpty()) {

            Files.writeString(
                    outputFile,
                    "",
                    StandardCharsets.UTF_8
            );

            return;
        }


        List<BufferedReader> readers =
                new ArrayList<>();


        PriorityQueue<MergeEntry> queue =
                new PriorityQueue<>(
                        Comparator.comparing(
                                MergeEntry::line
                        )
                );


        try {

            /*
             * Open all sorted chunks and push their
             * first records onto the priority queue.
             */
            for (int i = 0;
                 i < chunkFiles.size();
                 i++) {

                BufferedReader reader =
                        Files.newBufferedReader(
                                chunkFiles.get(i),
                                StandardCharsets.UTF_8
                        );


                readers.add(reader);


                String firstLine =
                        reader.readLine();


                if (firstLine != null) {

                    queue.add(
                            new MergeEntry(
                                    firstLine,
                                    i
                            )
                    );
                }
            }


            try (BufferedWriter writer =
                         Files.newBufferedWriter(
                                 outputFile,
                                 StandardCharsets.UTF_8
                         )) {


                while (!queue.isEmpty()) {

                    MergeEntry entry =
                            queue.poll();


                    writer.write(
                            entry.line()
                    );

                    writer.newLine();


                    BufferedReader sourceReader =
                            readers.get(
                                    entry.readerIndex()
                            );


                    String nextLine =
                            sourceReader.readLine();


                    if (nextLine != null) {

                        queue.add(
                                new MergeEntry(
                                        nextLine,
                                        entry.readerIndex()
                                )
                        );
                    }
                }
            }

        } finally {

            /*
             * Close all readers even if merge fails.
             */
            for (BufferedReader reader : readers) {

                try {

                    reader.close();

                } catch (IOException ignored) {
                }
            }
        }
    }


