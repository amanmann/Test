import com.fasterxml.jackson.databind.ObjectMapper;

import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;
import java.io.InputStream;

import java.sql.CallableStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import java.util.Arrays;

public void writeStoredProcedureOutputToFile(
        String procedureName,
        String outputFilePath,
        String specFileName,
        Object... params) throws SQLException, IOException {

    /*
     * Load the required export spec from src/main/resources.
     *
     * Example:
     * man_rec_spec.json
     */
    ObjectMapper objectMapper = new ObjectMapper();

    ExportSpec spec;

    try (InputStream inputStream =
                 getClass()
                         .getClassLoader()
                         .getResourceAsStream(specFileName)) {

        if (inputStream == null) {
            throw new IOException(
                    "Spec file not found in src/main/resources: "
                            + specFileName);
        }

        spec = objectMapper.readValue(
                inputStream,
                ExportSpec.class);
    }


    /*
     * Build stored procedure call.
     *
     * Example:
     * {CALL dbo.myProcedure(?,?,?)}
     */
    StringBuilder callQuery =
            new StringBuilder(
                    "{CALL " + procedureName + "(");

    for (int i = 0; i < params.length; i++) {

        callQuery.append("?");

        if (i < params.length - 1) {
            callQuery.append(",");
        }
    }

    callQuery.append(")}");


    /*
     * Execute stored procedure and write formatted file.
     */
    try (
            CallableStatement stmt =
                    connection.prepareCall(
                            callQuery.toString());

            BufferedWriter writer =
                    new BufferedWriter(
                            new FileWriter(outputFilePath))
    ) {

        /*
         * Set SP parameters.
         */
        for (int i = 0; i < params.length; i++) {
            stmt.setObject(i + 1, params[i]);
        }


        boolean hasResults = stmt.execute();

        boolean recordWritten = false;


        /*
         * Handle stored procedures that may return
         * update counts before/after ResultSets.
         */
        while (true) {

            if (hasResults) {

                try (ResultSet rs =
                             stmt.getResultSet()) {

                    while (rs.next()) {

                        recordWritten = true;


                        /*
                         * Create one completely blank record
                         * using the record length from the spec.
                         *
                         * For ManRecSpec this will be 853.
                         */
                        char[] outputRecord =
                                new char[
                                        spec.getRecordLength()];

                        Arrays.fill(
                                outputRecord,
                                ' ');


                        /*
                         * Build the output record according
                         * to the selected JSON spec.
                         */
                        for (FieldSpec field :
                                spec.getFields()) {

                            String value;

                            try {

                                /*
                                 * Get the value by COLUMN NAME,
                                 * not ResultSet column position.
                                 *
                                 * This is important because the
                                 * JSON spec controls the output.
                                 */
                                value =
                                        rs.getString(
                                                field.getFieldName());

                            } catch (SQLException ex) {

                                throw new SQLException(
                                        "Column '"
                                                + field.getFieldName()
                                                + "' defined in "
                                                + specFileName
                                                + " was not returned by stored procedure "
                                                + procedureName,
                                        ex);
                            }


                            /*
                             * Null becomes blank.
                             */
                            if (value == null) {
                                value = "";
                            }


                            /*
                             * Width defined by Access spec.
                             */
                            int width =
                                    field.getWidth();


                            /*
                             * Prevent a value from overflowing
                             * into the next field.
                             */
                            if (value.length() > width) {

                                value =
                                        value.substring(
                                                0,
                                                width);
                            }


                            /*
                             * Access Start positions are 1-based.
                             *
                             * Java arrays are 0-based.
                             *
                             * Therefore:
                             *
                             * Access Start 1 -> Java index 0
                             * Access Start 2 -> Java index 1
                             * etc.
                             */
                            int startIndex =
                                    field.getStart() - 1;


                            /*
                             * Safety check for an invalid spec.
                             */
                            if (startIndex < 0
                                    || startIndex + width
                                    > outputRecord.length) {

                                throw new IOException(
                                        "Invalid field position in "
                                                + specFileName
                                                + ": "
                                                + field.getFieldName()
                                                + " start="
                                                + field.getStart()
                                                + ", width="
                                                + field.getWidth());
                            }


                            /*
                             * Place the actual value at the exact
                             * position defined by the spec.
                             *
                             * Anything remaining in the field
                             * stays as spaces because outputRecord
                             * was initialized with spaces.
                             */
                            for (int i = 0;
                                 i < value.length();
                                 i++) {

                                outputRecord[
                                        startIndex + i]
                                        =
                                        value.charAt(i);
                            }
                        }


                        /*
                         * Write completed formatted record.
                         */
                        writer.write(outputRecord);

                        writer.newLine();
                    }
                }

            } else {

                int updateCount =
                        stmt.getUpdateCount();


                /*
                 * -1 means there are no more results
                 * or update counts.
                 */
                if (updateCount == -1) {
                    break;
                }
            }


            /*
             * Move to next SP result.
             */
            hasResults =
                    stmt.getMoreResults();
        }


        /*
         * SAR N1 Access behaviour:
         *
         * If nothing was returned, write this instead
         * of creating an empty file.
         */
        if (!recordWritten) {

            writer.write(
                    "There is no activity");

            writer.newLine();
        }


        writer.flush();
    }


    System.out.println(
            "Stored procedure output written to file: "
                    + outputFilePath
                    + " using spec: "
                    + specFileName);
}




