import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;

public class FileUtils {

    /**
     * Copies a file to another directory.
     *
     * @param sourceFilePath      Full path of source file
     * @param destinationFolder   Destination directory
     * @param newFileName         Optional new file name.
     *                            Pass null or blank to keep original name.
     * @return Path of copied destination file
     */
    public static Path copyFile(
            String sourceFilePath,
            String destinationFolder,
            String newFileName) throws IOException {

        Path source = Path.of(sourceFilePath);
        Path destinationDir = Path.of(destinationFolder);

        // Create destination directory if it does not exist
        Files.createDirectories(destinationDir);

        String destinationFileName;

        if (newFileName == null || newFileName.isBlank()) {
            destinationFileName = source.getFileName().toString();
        } else {
            destinationFileName = newFileName;
        }

        Path destination =
                destinationDir.resolve(destinationFileName);

        Files.copy(
                source,
                destination,
                StandardCopyOption.REPLACE_EXISTING
        );

        return destination;
    }
}
