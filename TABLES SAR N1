    /*
     * ============================================================
     * FINAL RESULT
     * ============================================================
     */

    public record ComparisonResult(

            long productionTotalRecords,
            long productionValidRecords,
            long productionInvalidRecords,

            long migratedTotalRecords,
            long migratedValidRecords,
            long migratedInvalidRecords,

            long exactMatches,

            long probableMatches,

            long missingValidRecords,
            long extraValidRecords,

            List<RecordDifference> recordDifferences,

            List<DataRecord> remainingProduction,
            List<DataRecord> remainingMigrated,

            List<MalformedRecord> productionMalformedRecords,
            List<MalformedRecord> migratedMalformedRecords

    ) {


        public boolean exactDataMatch() {

            return productionInvalidRecords == 0
                    && migratedInvalidRecords == 0
                    && probableMatches == 0
                    && missingValidRecords == 0
                    && extraValidRecords == 0
                    && productionValidRecords
                    == migratedValidRecords;
        }


        public void printSummary() {

            System.out.println();

            System.out.println(
                    "============================================================"
            );

            System.out.println(
                    "FILE COMPARISON SUMMARY"
            );

            System.out.println(
                    "============================================================"
            );


            System.out.println();

            System.out.println(
                    "PRODUCTION"
            );

            System.out.printf(
                    "Total records             : %,d%n",
                    productionTotalRecords
            );

            System.out.printf(
                    "Valid records             : %,d%n",
                    productionValidRecords
            );

            System.out.printf(
                    "Malformed records         : %,d%n",
                    productionInvalidRecords
            );


            System.out.println();

            System.out.println(
                    "MIGRATED"
            );

            System.out.printf(
                    "Total records             : %,d%n",
                    migratedTotalRecords
            );

            System.out.printf(
                    "Valid records             : %,d%n",
                    migratedValidRecords
            );

            System.out.printf(
                    "Malformed records         : %,d%n",
                    migratedInvalidRecords
            );


            System.out.println();

            System.out.println(
                    "COMPARISON"
            );

            System.out.printf(
                    "Exact matches             : %,d%n",
                    exactMatches
            );

            System.out.printf(
                    "Records with differences  : %,d%n",
                    probableMatches
            );

            System.out.printf(
                    "Missing valid records     : %,d%n",
                    missingValidRecords
            );

            System.out.printf(
                    "Extra valid records       : %,d%n",
                    extraValidRecords
            );


            System.out.println(
                    "------------------------------------------------------------"
            );


            if (exactDataMatch()) {

                System.out.println(
                        "RESULT: PASS"
                );

                System.out.println(
                        "Files contain the same valid records ignoring order."
                );

            } else {

                System.out.println(
                        "RESULT: FAIL"
                );


                if (productionInvalidRecords > 0
                        || migratedInvalidRecords > 0) {

                    System.out.println(
                            "Malformed record(s) were detected."
                    );
                }


                if (probableMatches > 0) {

                    System.out.println(
                            "Logical records with column differences were detected."
                    );
                }


                if (missingValidRecords > 0) {

                    System.out.println(
                            "Production valid records are missing from migrated output."
                    );
                }


                if (extraValidRecords > 0) {

                    System.out.println(
                            "Migrated output contains extra valid records."
                    );
                }
            }


            System.out.println(
                    "============================================================"
            );
        }
    }


